# Copy to .env and adjust. Every value has a sane default inside the app.

PORT=8080
LOG_LEVEL=info

# Postgres (leave empty to run fully in-memory)
DATABASE_URL=postgres://crisis:crisis@localhost:5432/crisis?sslmode=disable
STORE_FALLBACK=true

# Dispatcher panel / API secret  (header: X-Dispatcher-Key)
DISPATCHER_API_KEY=dispatcher-secret

# Routing: auto | google | osrm | simulated
ROUTING_MODE=auto

# Google Maps Platform (optional — without keys: OpenStreetMap + OSRM)
# Browser key: Maps JavaScript API, restrict by HTTP referrer (http://localhost:*/*)
GOOGLE_MAPS_API_KEY=
# Server key: Routes API (computeRoutes, WALK). Defaults to GOOGLE_MAPS_API_KEY if empty;
# use a separate key WITHOUT referrer restriction (IP restriction or none).
GOOGLE_DIRECTIONS_API_KEY=
OSRM_URL=https://router.project-osrm.org
OSRM_PROFILE=driving
# Per-call limit for every external routing API (jury rule: > 5 s counts as an outage)
ROUTING_TIMEOUT=5s
ROUTE_CACHE_TTL=24h
# Simulate an external routing outage from start-up: 503 | timeout (empty = normal)
ROUTING_CHAOS=
WALKING_SPEED_MPS=1.3

# Kritik Böhran alqoritmi
CRISIS_WINDOW=5m
CRISIS_RADIUS_M=500
CRISIS_MIN_SIGNALS=4
SHELTER_ALERT_PCT=95
SHELTER_WARN_PCT=90

# Protection under load
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40

# Dispatcher accounts (JWT, HS256) — roles: viewer | operator | admin
JWT_SECRET=change-me-in-production-9f1c
DISPATCH_USERS=admin:admin123:admin,operator:operator123:operator,viewer:viewer123:viewer
TOKEN_TTL=8h
# Honour X-Forwarded-For (only behind a trusted reverse proxy / for botnet load tests)
TRUST_PROXY=false
# SOS flood protection
SOS_RATE_PER_MIN=10
SOS_BURST=5
SOS_DEDUPE_WINDOW=30s
SOS_FLOOD_THRESHOLD=60

DEFAULT_LANG=az

# Link root used inside SMS texts; SMS gateway (simulated = log + journal only)
PUBLIC_URL=http://localhost:8080
NOTIFY_PROVIDER=simulated
